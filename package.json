{
  "name": "esg-app",
  "productName": "Elm Story - NG",
  "description": "Elm Story - NG: a continuation of the Elm Story storyworld editor.",
  "version": "0.56.8",
  "author": {
    "name": "Ravetracer",
    "email": "me@ravetracer.de"
  },
  "contributors": [
    {
      "name": "Elm Story Games",
      "email": "elmstorygames@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ravetracer/Elm-Story-NG.git"
  },
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run engine:sync && electron-vite dev",
    "dev:noengine": "electron-vite dev",
    "dev:nosandbox": "npm run engine:sync && electron-vite dev --noSandbox",
    "dev:debug": "electron-vite dev --noSandbox --remoteDebuggingPort 9222",
    "build": "npm run engine:sync && npm run typecheck && electron-vite build",
    "dev:web": "npm run engine:sync && vite --config vite.web.config.mts",
    "build:web": "npm run engine:sync && vite build --config vite.web.config.mts",
    "preview:web": "vite preview --config vite.web.config.mts",
    "dev:docs": "vite --config vite.docs.config.mts",
    "build:docs": "vite build --config vite.docs.config.mts",
    "preview:docs": "vite preview --config vite.docs.config.mts",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder build --publish never",
    "typecheck": "tsc --noEmit && tsc --noEmit -p engine/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,engine/src}/**/*.{ts,tsx,less}\" \"*.{json,ts}\"",
    "engine:install": "npm --prefix ./engine install",
    "engine:build": "npm --prefix ./engine run build",
    "engine:styles": "rimraf ./src/styles/engine.less ./src/styles/engine-editor.less && copyfiles -f ./engine/assets/engine.less ./engine/assets/engine-editor.less ./src/styles",
    "engine:embed": "rimraf ./src/components/Storyteller/embedded && copyfiles -u 2 \"./engine/src/**/*\" ./src/components/Storyteller/embedded && rimraf ./src/components/Storyteller/embedded/main.tsx",
    "engine:sync": "npm run engine:build && npm run engine:styles && npm run engine:embed",
    "electron:install": "node scripts/ensure-electron.mjs",
    "postinstall": "npm run engine:install && npm run electron:install"
  },
  "build": {
    "productName": "Elm Story - NG",
    "appId": "com.esg.elmstory.ng",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "extraResources": [
      "./assets/**"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^12.1.5",
    "@types/howler": "^2.2.13",
    "@types/is-hotkey": "^0.1.10",
    "@types/is-url": "^1.2.32",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.1.2",
    "@types/react": "^17.0.93",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^17.0.26",
    "@types/react-page-visibility": "^6.4.4",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.2.0",
    "copyfiles": "^2.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "less": "^4.8.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ant-design/icons": "^4.8.3",
    "@atlaskit/tree": "^8.12.0",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource/fira-mono": "^4.5.10",
    "@fontsource/inter": "^4.5.15",
    "@fontsource/roboto-serif": "^4.5.9",
    "@react-hook/resize-observer": "^1.2.6",
    "@use-it/event-listener": "^0.1.7",
    "acorn": "^8.18.0",
    "ajv": "^8.17.1",
    "antd": "^4.24.16",
    "date-fns": "^2.30.0",
    "dexie": "^3.2.7",
    "jszip": "^3.10.1",
    "dexie-react-hooks": "^1.1.7",
    "electron-context-menu": "^4.1.2",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.4.0",
    "howler": "^2.2.4",
    "html-react-parser": "^1.4.14",
    "is-hotkey": "^0.2.0",
    "is-url": "^1.2.4",
    "lodash": "^4.18.1",
    "lodash-es": "^4.17.21",
    "lzwcompress": "^1.1.0",
    "md5": "^2.3.0",
    "music-metadata": "^11.14.0",
    "rc-dock": "^3.3.2",
    "react": "^17.0.2",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^17.0.2",
    "react-easy-crop": "^3.5.3",
    "react-fast-marquee": "^1.6.5",
    "react-flow-renderer": "^9.7.4",
    "react-image": "^4.1.0",
    "react-page-visibility": "^6.4.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^5.3.4",
    "react-select": "^5.10.2",
    "react-spring": "^9.7.5",
    "react-string-replace": "^0.4.4",
    "react-transition-group": "^4.4.5",
    "semver": "^7.8.5",
    "slate": "^0.72.8",
    "slate-history": "^0.66.0",
    "slate-react": "^0.72.9",
    "unique-names-generator": "^4.7.1",
    "use-debounce": "^7.0.1",
    "use-resize-observer": "^7.1.0",
    "uuid": "^14.0.1"
  },
  "_allowScriptsNote": [
    "npm 11 blocks dependency install scripts until they are listed here.",
    "esbuild: its install script validates and links the platform binary. The",
    "binary itself arrives via optionalDependencies, so builds work either way,",
    "but allowing it keeps the check in place and silences the install warning.",
    "core-js and fsevents are denied deliberately. core-js@2's postinstall only",
    "prints a funding banner, and fsevents is macOS-only and ships prebuilt.",
    "Electron is absent from this list because v43 declares no install script at",
    "all; its binary is fetched by scripts/ensure-electron.mjs instead."
  ],
  "allowScripts": {
    "esbuild": true,
    "core-js": false,
    "fsevents": false
  },
  "_acceptedAdvisories": [
    "GHSA-mh99-v99m-4gvg (brace-expansion, unbounded expansion causing OOM) is",
    "knowingly accepted. It covers everything up to 5.0.7 and was never",
    "backported, so no 1.x or 2.x release is clean. Forcing 5.0.8 through",
    "overrides does not work: minimatch 3 and 4 do `require('brace-expansion')`",
    "and call the result, while 5.0.8's CommonJS build exports a named `expand`,",
    "which breaks ESLint with 'expand is not a function'. The affected copies",
    "reach us only through minimatch and glob inside build tooling, which sees",
    "nothing but glob patterns written in this repository, so there is no",
    "untrusted input path. Revisit when those packages ship a compatible",
    "brace-expansion."
  ]
}
