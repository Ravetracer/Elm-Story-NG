# This project was originally resolved with Yarn 1, which only warned about
# unsatisfied peer ranges. npm enforces them, and part of this dependency set
# cannot satisfy them on React 17:
#
#   @atlaskit/tree  v8 peers react@^16.8.0, v9 peers react@^18.2.0
#                   No release targets React 17, so no version of it can
#                   declare compatibility with the React this app runs on.
#
# React 17 is API-compatible with 16.8 for everything these packages use, which
# is why the original app worked. Set here rather than passed ad hoc so every
# install in this repo resolves identically.
#
# Revisit when the renderer moves to React 18: @atlaskit/tree v9 targets it
# directly and this flag may no longer be needed.
legacy-peer-deps=true
